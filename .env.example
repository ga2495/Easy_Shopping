# ============================================================
# ShopEase — Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# Server Port
PORT=3000

# Database Configuration (Standard Local / Custom Server)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=shopease
DB_SSL=false

# Database Configuration (Optional Connection URI for Cloud Providers like Railway / Aiven / TiDB)
# DATABASE_URL=mysql://root:password@localhost:3306/shopease
# MYSQL_URL=mysql://root:password@localhost:3306/shopease

# JWT Secret Key (Used for signing authentication tokens)
JWT_SECRET=your_super_secret_jwt_key_here

# Razorpay Credentials (Optional: Leave empty for local browsing; set for payment checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
